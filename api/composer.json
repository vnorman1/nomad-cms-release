{
    "name": "nomad/cms-api",
    "description": "NOMAD CMS Backend API with enterprise-grade security",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.0",
        "defuse/php-encryption": "^2.4",
        "endroid/qr-code": "^5.0",
        "firebase/php-jwt": "^6.10",
        "lbuchs/webauthn": "^2.1",
        "monolog/monolog": "^3.5",
        "nikolaposa/rate-limit": "^3.0",
        "paragonie/sodium_compat": "^1.21",
        "ramsey/uuid": "^4.7",
        "spomky-labs/otphp": "^11.3",
        "symfony/security-csrf": "^6.4",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "NomadCMS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "platform-check": false,
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "test": "phpstan analyse src -l max",
        "cs-check": "phpcs --standard=PSR12 src/",
        "cs-fix": "phpcbf --standard=PSR12 src/"
    }
}